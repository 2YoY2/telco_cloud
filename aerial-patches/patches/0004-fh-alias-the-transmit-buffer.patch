Subject: [PATCH 0004] aerial-fh: alias the transmit buffer so it can be resized without stopping the queue

The fronthaul transmit buffer is the largest single allocation in the system.
Measured on GH200 with a live DU-High attached:

    [FH.DOCA] Mapping transmit queue buffer (0xe38340000000 size 17179869184B
              dmabuf fd 237) with dmabuf mode

16 GiB, in one allocation, out of a 26,146 MiB process footprint.

It cannot be shrunk the obvious way. Every setter in doca_eth_rxq.h is documented
"can only be called before calling doca_ctx_start()", including the one that binds
the packet buffer, so resizing means stopping the queue -- a fronthaul outage
rather than a glitch.

So instead of changing the buffer, change what is behind it. AERIAL_FH_ALIAS_N=N
reserves the full virtual range, creates one physical allocation of size/N, and
maps it at every offset across the range. DOCA and the NIC see exactly what they
saw before: same base address, same length, same mkey, queue never stopped. Only
the physical footprint changes, by a factor of N.

Correctness needs the alias period to exceed the lifetime of a packet in the
buffer. On the transmit side the GPU writes a packet and the NIC reads it within
microseconds -- U-plane prepare 13.1 us and transmit 7.2 us, measured -- so the
margin is wide. This is why TX is the right place to try it first; the receive
ring has to hold packets for the whole order-kernel drain window instead.

N defaults to 1, which does not route through the new code at all and is the stock
path byte for byte. So the patch is inert until the environment variable is set,
and a sweep of N needs no rebuild.

If aliasing fails for any reason the allocator falls back to doca_gpu_mem_alloc,
and the existing dmabuf / nvidia-peermem branches below are untouched.

Not yet measured under load. What has to be watched as N rises is the order
kernel's RX Packet Dropped Count and the cell's CRC counter: a too-short alias
period corrupts packets rather than crashing.

Compile-verified on the 26-1-cubb tree. The GPU-direct fronthaul path this needs
does not exist on GB10 (see notes/05-fronthaul-blocked-on-gb10.md), so the runtime
test belongs on Grace Hopper -- see gh/README.md.

--- a/cuPHY-CP/aerial-fh-driver/lib/doca_obj.cpp
+++ b/cuPHY-CP/aerial-fh-driver/lib/doca_obj.cpp
@@ -20,6 +20,74 @@
 #include "gpu_comm.hpp"
 #include "aerial-fh-driver/api.hpp"
 #include "app_config.hpp"
+#include <cuda.h>
+#include <stdlib.h>
+
+/*
+ * NOTICE: modified from the NVIDIA Aerial CUDA-Accelerated RAN SDK 26-1-cubb.
+ * Change: AERIAL_FH_ALIAS_N backs the fronthaul transmit buffer with one physical
+ * allocation of size/N mapped N times across the full virtual range.
+ * Marked as required by Apache License 2.0 section 4(b).
+ */
+
+/*
+ * Back a buffer of `size` bytes with `size/n` bytes of physical memory, mapped n
+ * times across the full virtual range.
+ *
+ * The point is that DOCA and the NIC see no difference: same base address, same
+ * length, same mkey, and the queue never stops.  That matters because every setter
+ * in doca_eth_rxq.h is documented "can only be called before calling
+ * doca_ctx_start()", so resizing a buffer the obvious way means a fronthaul outage.
+ * Aliasing changes only what sits behind the addresses.
+ *
+ * Correctness needs the alias period to exceed the lifetime of a packet in the
+ * buffer.  On the transmit side that lifetime is microseconds (U-plane prepare
+ * ~13 us, transmit ~7 us measured), so the margin is large.
+ *
+ * n == 1 is the stock path and is not routed through here at all.
+ */
+static doca_error_t fh_alias_alloc(size_t size, int n, void **addr_out, size_t *phys_out)
+{
+    CUdevice dev = 0;
+    if(cuCtxGetDevice(&dev) != CUDA_SUCCESS) return DOCA_ERROR_BAD_STATE;
+
+    CUmemAllocationProp prop;
+    memset(&prop, 0, sizeof(prop));
+    prop.type          = CU_MEM_ALLOCATION_TYPE_PINNED;
+    prop.location.type = CU_MEM_LOCATION_TYPE_DEVICE;
+    prop.location.id   = (int)dev;
+
+    size_t gran = 0;
+    if(cuMemGetAllocationGranularity(&gran, &prop, CU_MEM_ALLOC_GRANULARITY_MINIMUM) != CUDA_SUCCESS)
+        return DOCA_ERROR_BAD_STATE;
+
+    size_t chunk = ((((size + (size_t)n - 1) / (size_t)n) + gran - 1) / gran) * gran;
+    size_t total = chunk * (size_t)n;          /* >= size, so the NIC never walks off the end */
+
+    CUdeviceptr va = 0;
+    if(cuMemAddressReserve(&va, total, gran, 0, 0) != CUDA_SUCCESS) return DOCA_ERROR_NO_MEMORY;
+
+    CUmemGenericAllocationHandle h = 0;
+    if(cuMemCreate(&h, chunk, &prop, 0) != CUDA_SUCCESS)
+    {
+        cuMemAddressFree(va, total);
+        return DOCA_ERROR_NO_MEMORY;
+    }
+    for(int k = 0; k < n; k++)
+    {
+        if(cuMemMap(va + (CUdeviceptr)k * chunk, chunk, 0, h, 0) != CUDA_SUCCESS)
+            return DOCA_ERROR_BAD_STATE;
+    }
+    CUmemAccessDesc acc;
+    memset(&acc, 0, sizeof(acc));
+    acc.location = prop.location;
+    acc.flags    = CU_MEM_ACCESS_FLAGS_PROT_READWRITE;
+    if(cuMemSetAccess(va, total, &acc, 1) != CUDA_SUCCESS) return DOCA_ERROR_BAD_STATE;
+
+    *addr_out = (void *)va;
+    *phys_out = chunk;
+    return DOCA_SUCCESS;
+}
 
 
 #define GPU_PAGE_SHIFT 16
@@ -484,7 +552,23 @@
 	}
 	else
 	{
-		status = doca_gpu_mem_alloc(buf->gpu_dev, size , sysconf(_SC_PAGESIZE), buf->mtype, (void **)&(buf->gpu_pkt_addr), NULL);
+		int         alias_n   = 1;
+		const char *alias_env = getenv("AERIAL_FH_ALIAS_N");
+		if(alias_env) alias_n = atoi(alias_env);
+
+		status = DOCA_ERROR_BAD_STATE;
+		if(alias_n > 1)
+		{
+			size_t phys = 0;
+			status = fh_alias_alloc(size, alias_n, (void **)&(buf->gpu_pkt_addr), &phys);
+			if(status == DOCA_SUCCESS)
+				NVLOGC_FMT(TAG, "TX buffer aliased x{}: {}B virtual backed by {}B physical, {}B returned",
+					alias_n, size, phys, size > phys ? size - phys : 0);
+			else
+				NVLOGE_FMT(TAG, AERIAL_INVALID_PARAM_EVENT, "TX buffer aliasing x{} failed, using plain allocation", alias_n);
+		}
+		if(status != DOCA_SUCCESS)
+			status = doca_gpu_mem_alloc(buf->gpu_dev, size , sysconf(_SC_PAGESIZE), buf->mtype, (void **)&(buf->gpu_pkt_addr), NULL);
 	}
 	if ((status != DOCA_SUCCESS) || (buf->gpu_pkt_addr == NULL)) {
 		NVLOGE_FMT(TAG, AERIAL_INVALID_PARAM_EVENT, "Unable to alloc txbuf: failed to allocate gpu memory");
