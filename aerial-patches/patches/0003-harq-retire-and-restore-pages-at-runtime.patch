+    /**
+     * @brief Give the physical pages back to the driver, keep the address.
+     *
+     * After this the virtual address is still reserved and still ours, so no
+     * pointer held anywhere becomes dangling or reusable by someone else, but the
+     * memory is genuinely returned and another process can allocate it.
+     * Touching the address while released faults -- the caller is responsible for
+     * knowing nothing will.
+     *
+     * @return bytes handed back, 0 if it was not ours or was already released
+     */
+    static size_t release_physical(void* addr)
+    {
+        using namespace aerial_vmm;
+        Region* r = nullptr;
+        std::lock_guard<std::mutex> lk(lock());
+        auto it = table().find(addr);
+        if(it == table().end()) return 0;
+        r = &it->second;
+        if(!r->mapped) return 0;
+        check(cuMemUnmap(r->va, r->size), "cuMemUnmap");
+        check(cuMemRelease(r->handle),    "cuMemRelease");
+        r->handle = 0;
+        r->mapped = false;
+        mappedB() -= r->size;
+        return r->size;
+    }
+
+    /// Put pages back behind an address released above.  Same address, new physical memory.
+    static size_t restore_physical(void* addr)
+    {
+        using namespace aerial_vmm;
+        std::lock_guard<std::mutex> lk(lock());
+        auto it = table().find(addr);
+        if(it == table().end()) return 0;
+        Region& r = it->second;
+        if(r.mapped) return 0;
+
+        check(cuMemCreate(&r.handle, r.size, &r.prop, 0), "cuMemCreate (restore)");
+        check(cuMemMap(r.va, r.size, 0, r.handle, 0),   "cuMemMap (restore)");
+        CUmemAccessDesc acc{};
+        acc.location = r.prop.location;
+        acc.flags    = CU_MEM_ACCESS_FLAGS_PROT_READWRITE;
+        check(cuMemSetAccess(r.va, r.size, &acc, 1), "cuMemSetAccess (restore)");
+        r.mapped = true;
+        mappedB() += r.size;
+        return r.size;
+    }
+
+    /// Bytes currently mapped through this allocator.
+    static size_t mapped_bytes() { return aerial_vmm::mappedB().load(); }
