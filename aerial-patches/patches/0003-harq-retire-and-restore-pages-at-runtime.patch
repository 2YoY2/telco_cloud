+//////////////////////////////////////////////////////////////////////////////////////////////////////////////
+//// Handing HARQ pages back to the driver while the cell runs
+////
+//// The free ring is the interlock.  A buffer in it has been returned by its
+//// callback, so nothing references it and its pages can go without any new
+//// drain protocol.  The virtual address stays reserved, so no pointer held by a
+//// CUDA graph or a descriptor table is disturbed.
+//////////////////////////////////////////////////////////////////////////////////////////////////////////////
+size_t HarqPool::retireFree(size_t n)
+{
+    size_t bytes = 0;
+    for(size_t i = 0; i < n; i++)
+    {
+        HarqBuffer* buf = nullptr;
+        if(aerial_fh::ring_dequeue(hb_ring, (void**)&buf) || buf == nullptr) break;
+        size_t b = vmm_alloc::release_physical((void*)buf->getAddr());
+        if(b == 0)                                  // not VMM-backed; put it straight back
+        {
+            aerial_fh::ring_enqueue(hb_ring, (void*)buf);
+            break;
+        }
+        retired_.push_back(buf);
+        bytes += b;
+    }
+    return bytes;
+}
+
+size_t HarqPool::restoreRetired(size_t n)
+{
+    size_t bytes = 0;
+    while(n-- > 0 && !retired_.empty())
+    {
+        HarqBuffer* buf = retired_.back();
+        bytes += vmm_alloc::restore_physical((void*)buf->getAddr());
+        retired_.pop_back();
+        aerial_fh::ring_enqueue(hb_ring, (void*)buf);
+    }
+    return bytes;
+}
+
+size_t HarqPool::retiredCount() const { return retired_.size(); }
+
+namespace {
+
+std::vector<HarqPool*>& harq_registry()      { static std::vector<HarqPool*> v; return v; }
+std::mutex&             harq_registry_lock() { static std::mutex m; return m; }
+
+/// Poll a control file so retire/restore can be driven from outside while the
+/// cell runs.  Deliberately crude: this is a test harness, not the API.  The
+/// real control path belongs on the OAM gRPC service, off the real-time cores.
+void harq_ctl_watcher()
+{
+    const char* in  = "/var/log/aerial/harq_ctl";
+    const char* out = "/var/log/aerial/harq_ctl.out";
+    // This thread drives CUDA VMM calls, so it needs a context of its own.
+    CUdevice  dev = 0;
+    CUcontext ctx = nullptr;
+    if(cuDeviceGet(&dev, 0) == CUDA_SUCCESS && cuDevicePrimaryCtxRetain(&ctx, dev) == CUDA_SUCCESS)
+        cuCtxSetCurrent(ctx);
+
+    for(;;)
+    {
+        std::this_thread::sleep_for(std::chrono::milliseconds(200));
+        std::string cmd; size_t n = 0;
+        {
+            std::ifstream f(in);
+            if(!f.good()) continue;
+            f >> cmd >> n;
+        }
+        std::remove(in);
+        if(cmd.empty() || n == 0) continue;
+
+        std::vector<HarqPool*> pools;
+        { std::lock_guard<std::mutex> lk(harq_registry_lock()); pools = harq_registry(); }
+
+        size_t bytes = 0, left = n, retired = 0;
+        std::string err;
+        try
+        {
+            for(auto* p : pools)
+            {
+                if(left == 0) break;
+                size_t b = (cmd == "retire") ? p->retireFree(left) : (cmd == "restore") ? p->restoreRetired(left) : 0;
+                size_t did = (p->getSize() ? (b + p->getSize() - 1) / p->getSize() : 0);
+                bytes += b; left -= (did < left ? did : left);
+            }
+            for(auto* p : pools) retired += p->retiredCount();
+        }
+        catch(const std::exception& e) { err = e.what(); }   // never take the L1 down
+
+        std::ofstream o(out, std::ios::app);
+        o << cmd << " " << n << " -> " << (bytes >> 20) << " MiB moved, "
+          << retired << " buffers retired, " << (vmm_alloc::mapped_bytes() >> 20)
+          << " MiB still mapped" << (err.empty() ? "" : "  ERROR: " + err) << std::endl;
+    }
+}
+
+} // namespace
+
+void harq_ctl_start(HarqPool* p)
+{
+    static std::once_flag once;
+    { std::lock_guard<std::mutex> lk(harq_registry_lock()); harq_registry().push_back(p); }
+    std::call_once(once, []{ std::thread(harq_ctl_watcher).detach(); });
 }
 
