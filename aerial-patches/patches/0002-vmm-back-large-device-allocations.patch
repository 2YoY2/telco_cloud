 #if USE_NVTX
 #include "nvtx3/nvToolsExt.h"
@@ -1126,6 +1134,11 @@
  * Allocator for device (GPU) memory using cudaMalloc/cudaFree.
  * Used with IOBuf template for device-side buffer management.
  */
+/// Allocations at least this large take the VMM path.  Below one allocation
+/// granule (2 MiB on GB10) VMM rounds up catastrophically, and cuphydriver has
+/// 27 call sites that allocate between 1 and 8 bytes.
+static constexpr size_t kVmmThreshold = 2u * 1024u * 1024u;
+
 struct device_alloc
 {
     /**
@@ -1136,6 +1149,8 @@
      */
     static void* allocate(size_t nbytes)
     {
+        if(nbytes >= kVmmThreshold)
+            return vmm_alloc::allocate(nbytes);
         void* addr;
         CUDA_CHECK_PHYDRIVER(cudaMalloc(&addr, nbytes));
         return addr;
@@ -1149,6 +1164,11 @@
     static void deallocate(void* addr)
     {
         // NVLOGE_FMT(TAG, AERIAL_CUDA_API_EVENT, "device_alloc CUDA_CHECK_PHYDRIVER(cudaFree"));
+        if(vmm_alloc::owns(addr))
+        {
+            vmm_alloc::deallocate(addr);
+            return;
+        }
         CUDA_CHECK_PHYDRIVER(cudaFree(addr));
     }
 
